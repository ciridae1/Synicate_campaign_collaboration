        <mxCell id="H5OY3X-8F7X_Oy3o84kl-5" value="Help out a miner in the Core named Zahir Gilmour. Later, rescue his friend Elise Klamikonov who is an alien researcher for the Syndicate." style="rounded=1;whiteSpace=wrap;html=1;horizontal=1;" parent="1" vertex="1">
